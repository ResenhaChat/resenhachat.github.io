<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog id="pdfViewerDialog" showHeader="false" stretch="true" class="rsMediaViewer rsPdfViewer"
        afterOpen=".onOpened" afterClose=".onClosed">
        <content>
            <VBox class="rsPdfBody" renderType="Bare">
                <HBox class="rsViewerBar" renderType="Bare" alignItems="Center" justifyContent="SpaceBetween">
                    <VBox class="rsPdfTitle" renderType="Bare">
                        <Text text="{compose>/fileName}" maxLines="1" class="rsViewerName" />
                        <Text text="{compose>/pageLabel}" class="rsPdfPageLabel" visible="{= !${compose>/error} &amp;&amp; !${compose>/loading} }" />
                    </VBox>
                    <HBox class="rsViewerActions" renderType="Bare" alignItems="Center">
                        <Button id="pdfDownload" icon="sap-icon://download" type="Transparent" class="rsViewerBtn"
                            tooltip="{i18n>download}" press=".onDownload" />
                        <Button id="pdfClose" icon="sap-icon://decline" type="Transparent" class="rsViewerBtn"
                            tooltip="{i18n>closeDialog}" press=".onClose" />
                    </HBox>
                </HBox>

                <VBox class="rsPdfMessage" renderType="Bare" alignItems="Center" justifyContent="Center" visible="{compose>/error}">
                    <Text text="{i18n>pdfLoadError}" textAlign="Center" class="rsPdfMessageText" />
                    <Button text="{i18n>download}" icon="sap-icon://download" type="Emphasized" class="rsGradientBtn" press=".onDownload" />
                </VBox>
                <Text text="{i18n>pdfLoading}" class="rsPdfMessageText rsPdfLoading" visible="{compose>/loading}" />

                <core:HTML id="pdfHost" class="rsPdfHost" sanitizeContent="false"
                    content="&lt;div class=&quot;rsPdfPages&quot;&gt;&lt;/div&gt;" />
            </VBox>
        </content>
    </Dialog>
</core:FragmentDefinition>
