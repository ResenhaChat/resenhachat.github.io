<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog id="addMembersDialog" title="{i18n>addPeopleTitle}" contentWidth="26rem" stretch="{device>/system/phone}"
        class="rsPeopleDialog">
        <content>
            <VBox class="rsPeopleBody" renderType="Bare">
                <SearchField id="addMembersSearch" placeholder="{i18n>peopleSearchPlaceholder}" value="{compose>/term}"
                    liveChange=".onSearch" class="rsPeopleSearch" />
                <List id="addMembersList" mode="MultiSelect" showSeparators="None" noDataText="{i18n>noPeople}" class="rsPeopleList"
                    growing="true" growingThreshold="30" selectionChange=".onSelectionChange"
                    items="{ path: '/People', suspended: true, parameters: { $orderby: 'DisplayName' } }">
                    <CustomListItem type="Inactive" class="rsPersonItem"
                        selected="{parts: [{path: 'ID', targetType: 'any'}, {path: 'compose>/selected'}], formatter: '.formatter.isPicked'}">
                        <HBox class="rsPersonRow" renderType="Bare" alignItems="Center">
                            <HBox class="rsAvatarWrap" renderType="Bare">
                                <Avatar displaySize="S" initials="{path: 'DisplayName', targetType: 'any', formatter: '.formatter.initials'}"
                                    src="{parts: [{path: 'ID', targetType: 'any'}, {path: 'AvatarMimeType', targetType: 'any'}, {path: 'AvatarVersion', targetType: 'any'}, {path: 'session>/mediaToken'}], formatter: '.formatter.personAvatarSrc'}"
                                    backgroundColor="{path: 'ID', targetType: 'any', formatter: '.formatter.accent'}" />
                                <Text class="rsOnlineDot"
                                    visible="{parts: [{path: 'ID', targetType: 'any'}, {path: 'presence>/online'}], formatter: '.formatter.isOnline'}" />
                            </HBox>
                            <VBox class="rsPersonBody" renderType="Bare">
                                <Text text="{DisplayName}" maxLines="1" class="rsPersonName" />
                                <Text text="@{Username}" maxLines="1" class="rsPersonHandle" />
                            </VBox>
                        </HBox>
                    </CustomListItem>
                </List>
            </VBox>
        </content>
        <beginButton>
            <Button id="addMembersConfirm" text="{i18n>add}" type="Emphasized" press=".onConfirmAdd" class="rsGradientBtn" />
        </beginButton>
        <endButton>
            <Button id="addMembersCancel" text="{i18n>cancel}" type="Transparent" press=".onCancelAdd" class="rsGhostBtn" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
