<mvc:View
    controllerName="apps.dflc.resenha.controller.Chat"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    displayBlock="true"
>
    <HBox id="chatPage" class="rsChatPage" width="100%" height="100%" renderType="Bare">
        <customData>
            <core:CustomData key="rs-view" value="{ui>/mobileView}" writeToDom="true" />
            <core:CustomData key="rs-details" value="{= ${ui>/detailsOpen} ? 'true' : 'false' }" writeToDom="true" />
        </customData>

        <VBox id="sidebar" class="rsSidebar" renderType="Bare" height="100%">
            <HBox class="rsSideHead" renderType="Bare" alignItems="Center" justifyContent="SpaceBetween">
                <HBox class="rsBrand" renderType="Bare" alignItems="Center">
                    <Image src="img/logo.svg" alt="{i18n>appName}" class="rsBrandLogo" />
                    <Text text="{i18n>appName}" class="rsBrandName" />
                </HBox>
                <HBox class="rsSideActions" renderType="Bare" alignItems="Center">
                    <Button id="newChatButton" class="rsRoundBtn" type="Transparent" icon="sap-icon://add"
                        tooltip="{i18n>newChatTooltip}" press=".newChat.onOpenMenu" />
                    <Button id="themeButton" class="rsRoundBtn" type="Transparent"
                        icon="{path: 'ui>/darkMode', formatter: '.formatter.themeIcon'}"
                        tooltip="{i18n>themeToggle}" press=".conversations.onToggleTheme" />
                    <Avatar id="meAvatar" displaySize="S" class="rsMeAvatar" tooltip="{i18n>menuTooltip}"
                        initials="{path: 'DisplayName', targetType: 'any', formatter: '.formatter.initials'}"
                        backgroundColor="{path: 'ID', targetType: 'any', formatter: '.formatter.accent'}"
                        press=".conversations.onOpenMenu" />
                </HBox>
            </HBox>

            <HBox class="rsSearch" renderType="Bare" alignItems="Center">
                <core:Icon src="sap-icon://search" decorative="true" class="rsSearchIcon" />
                <Input id="conversationSearch" class="rsSearchInput" width="100%" placeholder="{i18n>searchPlaceholder}"
                    valueLiveUpdate="true" liveChange=".conversations.onSearch" />
            </HBox>

            <VBox id="onlineStrip" class="rsOnline" renderType="Bare"
                visible="{parts: [{path: 'presence>/online'}, {path: 'session>/user/ID'}], formatter: '.formatter.hasOthersOnline'}">
                <Text text="{i18n>onlineNow}" class="rsSectionLabel" />
                <ScrollContainer id="onlineScroll" width="100%" horizontal="true" vertical="false" class="rsOnlineScroll">
                    <HBox id="onlineList" class="rsOnlineList" renderType="Bare"
                        items="{ path: '/People', suspended: true, parameters: { $select: 'DisplayName' } }">
                        <VBox class="rsOnlineItem" renderType="Bare">
                            <VBox class="rsRing" renderType="Bare">
                                <Avatar displaySize="XS" class="rsRingAvatar"
                                    initials="{path: 'DisplayName', targetType: 'any', formatter: '.formatter.initials'}"
                                    backgroundColor="{path: 'ID', targetType: 'any', formatter: '.formatter.accent'}" />
                            </VBox>
                            <Text class="rsOnlineName" wrapping="false"
                                text="{path: 'DisplayName', targetType: 'any', formatter: '.formatter.firstName'}" />
                        </VBox>
                    </HBox>
                </ScrollContainer>
            </VBox>

            <HBox id="pushBanner" class="rsPushBanner" renderType="Bare" alignItems="Center"
                visible="{notifications>/bannerVisible}">
                <core:Icon src="sap-icon://bell" decorative="true" class="rsPushBannerIcon" />
                <Text text="{i18n>pushBannerText}" maxLines="2" class="rsPushBannerText" />
                <Button id="pushBannerLater" text="{i18n>pushBannerLater}" type="Transparent"
                    class="rsGhostBtn rsPushBannerBtn" press=".notifications.onBannerLater" />
                <Button id="pushBannerEnable" text="{i18n>pushBannerEnable}" type="Emphasized"
                    class="rsGradientBtn rsPushBannerBtn" press=".notifications.onBannerEnable" />
            </HBox>

            <HBox class="rsListTools" renderType="Bare" alignItems="Center" justifyContent="End">
                <Button id="archivedToggle" class="rsArchiveToggle" type="Transparent" icon="sap-icon://inbox"
                    text="{path: 'ui>/showArchived', formatter: '.formatter.archivedToggleLabel'}"
                    press=".conversations.onToggleArchived">
                    <customData>
                        <core:CustomData key="rs-state" writeToDom="true" value="{= ${ui>/showArchived} ? 'on' : 'off' }" />
                    </customData>
                </Button>
            </HBox>

            <ScrollContainer id="conversationScroll" vertical="true" height="auto" class="rsScroll">
                <List id="conversationList" mode="SingleSelectMaster" showSeparators="None" growing="true"
                    growingThreshold="30" noDataText="{path: 'ui>/showArchived', formatter: '.formatter.emptyListText'}" class="rsConvList"
                    selectionChange=".conversations.onSelect" updateFinished=".conversations.onUpdateFinished"
                    items="{
                        path: '/Members',
                        suspended: true,
                        parameters: {
                            $$updateGroupId: 'membership',
                            $orderby: 'IsPinned desc,Conversation/LastMessageAt desc',
                            $expand: 'Conversation($select=ID,Kind,Name,Description,LastMessage,LastMessageAt,OnlyAdminsCanPost,IsPublic)'
                        },
                        events: { dataReceived: '.onConversationsDataReceived' }
                    }">
                    <CustomListItem type="Active" class="rsConvItem">
                        <customData>
                            <core:CustomData key="rs-kind" value="{= ${Conversation/Kind} || 'None' }" writeToDom="true" />
                        </customData>
                        <HBox class="rsConvRow" renderType="Bare" alignItems="Center">
                            <HBox class="rsAvatarWrap rsConvAvatarWrap" renderType="Bare">
                                <Avatar class="rsConvAvatar" displaySize="S"
                                    src="{path: 'Conversation/Kind', targetType: 'any', formatter: '.formatter.conversationIcon'}"
                                    initials="{path: 'Title', targetType: 'any', formatter: '.formatter.initials'}"
                                    backgroundColor="{path: 'Conversation_ID', targetType: 'any', formatter: '.formatter.accent'}" />
                                <Text class="rsOnlineDot"
                                    visible="{parts: [{path: 'Conversation/Kind', targetType: 'any'}, {path: 'DirectPeer_ID', targetType: 'any'}, {path: 'presence>/online'}], formatter: '.formatter.isDirectOnline'}" />
                            </HBox>
                            <VBox class="rsConvBody" renderType="Bare">
                                <HBox renderType="Bare" justifyContent="SpaceBetween" alignItems="Center">
                                    <HBox class="rsConvTitleLine" renderType="Bare" alignItems="Center">
                                        <core:Icon src="sap-icon://pushpin-on" decorative="true" class="rsConvStateIcon"
                                            visible="{IsPinned}" />
                                        <Text text="{Title}" maxLines="1" class="rsConvName" />
                                        <core:Icon src="sap-icon://sound-off" decorative="true" class="rsConvStateIcon"
                                            visible="{path: 'MutedUntil', targetType: 'any', formatter: '.formatter.isMuted'}" />
                                    </HBox>
                                    <Text class="rsConvTime"
                                        text="{path: 'Conversation/LastMessageAt', targetType: 'any', formatter: '.formatter.conversationTime'}" />
                                </HBox>
                                <HBox renderType="Bare" justifyContent="SpaceBetween" alignItems="Center">
                                    <Text maxLines="1" class="rsConvPreview"
                                        visible="{parts: [{path: 'Conversation_ID', targetType: 'any'}, {path: 'presence>/typing'}], formatter: '.formatter.isNotTypingIn'}"
                                        text="{path: 'Conversation/LastMessage', targetType: 'any', formatter: '.formatter.messagePreview'}" />
                                    <HBox class="rsTypingLine" renderType="Bare"
                                        visible="{parts: [{path: 'Conversation_ID', targetType: 'any'}, {path: 'presence>/typing'}], formatter: '.formatter.isTypingIn'}">
                                        <Text text="{i18n>typingShort}" />
                                        <Text class="rsDot" />
                                        <Text class="rsDot" />
                                        <Text class="rsDot" />
                                    </HBox>
                                    <Text class="rsBadge" text="{path: 'UnreadCount', targetType: 'any', formatter: '.formatter.unreadBadge'}"
                                        tooltip="{path: 'UnreadCount', targetType: 'any', formatter: '.formatter.unreadTooltip'}"
                                        visible="{path: 'UnreadCount', targetType: 'any', formatter: '.formatter.hasUnread'}" />
                                </HBox>
                            </VBox>
                            <Button class="rsRowMenuBtn" type="Transparent" icon="sap-icon://overflow"
                                tooltip="{i18n>conversationMenuTooltip}" press=".actions.onOpenRowMenu" />
                        </HBox>
                    </CustomListItem>
                </List>
            </ScrollContainer>
        </VBox>

        <VBox id="messagesPage" class="rsMain" renderType="Bare" height="100%">
            <VBox id="emptyState" class="rsEmpty" renderType="Bare" alignItems="Center" justifyContent="Center"
                visible="{= !${ui>/conversationId} }">
                <Image src="img/logo.svg" alt="{i18n>appName}" class="rsEmptyLogo" />
                <Title text="{i18n>emptyTitle}" titleStyle="H3" class="rsEmptyTitle" />
                <Text text="{i18n>emptyText}" textAlign="Center" class="rsEmptyText" />
            </VBox>

            <VBox id="chatColumn" class="rsColumn rsChatColumn" renderType="Bare" visible="{= !!${ui>/conversationId} }">
                <HBox id="chatHeader" class="rsChatHeader" renderType="Bare" alignItems="Center">
                    <customData>
                        <core:CustomData key="rs-kind" value="{= ${Kind} || 'None' }" writeToDom="true" />
                    </customData>
                    <Button id="backButton" icon="sap-icon://nav-back" type="Transparent" tooltip="{i18n>back}"
                        class="rsRoundBtn rsBackBtn" press=".messages.onBack" />
                    <HBox id="chatTitle" class="rsChatTitleArea" renderType="Bare" alignItems="Center">
                        <HBox class="rsAvatarWrap rsChatAvatarWrap" renderType="Bare">
                            <Avatar displaySize="S" class="rsChatAvatar"
                                src="{path: 'Kind', targetType: 'any', formatter: '.formatter.conversationIcon'}"
                                initials="{path: 'Title', targetType: 'any', formatter: '.formatter.initials'}"
                                backgroundColor="{path: 'ID', targetType: 'any', formatter: '.formatter.accent'}" />
                            <Text class="rsOnlineDot"
                                visible="{parts: [{path: 'Kind', targetType: 'any'}, {path: 'DirectPeer_ID', targetType: 'any'}, {path: 'presence>/online'}], formatter: '.formatter.isDirectOnline'}" />
                        </HBox>
                        <VBox class="rsChatTitle" renderType="Bare">
                            <Text text="{Title}" maxLines="1" class="rsChatName" />
                            <Text text="{ui>/subtitle}" maxLines="1" class="rsSubtitle" visible="{= !${ui>/isTyping} }">
                                <customData>
                                    <core:CustomData key="rs-state" writeToDom="true"
                                        value="{= ${ui>/subtitleOnline} ? 'online' : 'idle' }" />
                                </customData>
                            </Text>
                            <HBox class="rsTypingLine rsSubtitle" renderType="Bare" visible="{ui>/isTyping}">
                                <Text text="{ui>/typingLabel}" maxLines="1" />
                                <Text class="rsDot" />
                                <Text class="rsDot" />
                                <Text class="rsDot" />
                            </HBox>
                        </VBox>
                    </HBox>
                    <Button id="detailsButton" icon="sap-icon://hint" type="Transparent" tooltip="{i18n>detailsTooltip}"
                        class="rsRoundBtn" press=".details.onOpen" />
                </HBox>

                <ScrollContainer id="messageScroll" vertical="true" height="auto" class="rsScroll rsMessageScroll">
                    <List id="messageList" showSeparators="None" backgroundDesign="Transparent" growing="true"
                        growingThreshold="30" growingDirection="Upwards" growingScrollToLoad="true"
                        noDataText="{i18n>noMessages}" class="rsMessageList"
                        updateFinished=".messages.onUpdateFinished"
                        items="{
                            path: 'Messages',
                            parameters: {
                                $$ownRequest: true,
                                $orderby: 'createdAt desc',
                                $expand: 'Sender($select=ID,DisplayName,Username)'
                            },
                            events: { dataReceived: '.onDataReceived' }
                        }">
                        <CustomListItem type="Inactive" class="rsMsgItem">
                            <customData>
                                <core:CustomData key="rs-mine" writeToDom="true"
                                    value="{parts: [{path: 'Sender/ID', targetType: 'any'}, {path: 'session>/user/ID'}], formatter: '.formatter.isMine'}" />
                            </customData>
                            <VBox renderType="Bare">
                                <Text class="rsDaySep" visible="false" />
                                <HBox class="rsRow" renderType="Bare"
                                    visible="{path: 'Kind', targetType: 'any', formatter: '.formatter.isNotSystem'}">
                                    <HBox class="rsAvatarWrap" renderType="Bare">
                                        <Avatar displaySize="XS"
                                            initials="{path: 'Sender/DisplayName', targetType: 'any', formatter: '.formatter.initials'}"
                                            backgroundColor="{path: 'Sender/ID', targetType: 'any', formatter: '.formatter.accent'}" />
                                        <Text class="rsOnlineDot"
                                            visible="{parts: [{path: 'Sender/ID', targetType: 'any'}, {path: 'presence>/online'}], formatter: '.formatter.isOnline'}" />
                                    </HBox>
                                    <VBox class="rsBubble" renderType="Bare">
                                        <Text text="{Sender/DisplayName}" maxLines="1" class="rsSender" />
                                        <Text class="rsText"
                                            text="{parts: [{path: 'Text', targetType: 'any'}, {path: 'DeletedAt', targetType: 'any'}], formatter: '.formatter.messageText'}" />
                                        <HBox class="rsMeta" renderType="Bare" justifyContent="End" alignItems="Center">
                                            <Text class="rsEdited" text="{i18n>edited}"
                                                visible="{parts: [{path: 'EditedAt', targetType: 'any'}, {path: 'DeletedAt', targetType: 'any'}], formatter: '.formatter.isEdited'}" />
                                            <Text class="rsTime" text="{path: 'createdAt', targetType: 'any', formatter: '.formatter.time'}" />
                                        </HBox>
                                    </VBox>
                                </HBox>
                                <HBox class="rsSystemRow" renderType="Bare" justifyContent="Center"
                                    visible="{path: 'Kind', targetType: 'any', formatter: '.formatter.isSystem'}">
                                    <HBox class="rsSystemPill" renderType="Bare" alignItems="Center">
                                        <Text text="{Text}" maxLines="2" class="rsSystemText" />
                                        <Text class="rsSystemTime" text="{path: 'createdAt', targetType: 'any', formatter: '.formatter.time'}" />
                                    </HBox>
                                </HBox>
                            </VBox>
                        </CustomListItem>
                    </List>
                </ScrollContainer>

                <HBox id="composer" class="rsComposer" renderType="Bare" alignItems="End"
                    visible="{parts: [{path: 'OnlyAdminsCanPost', targetType: 'any'}, {path: 'MyRole', targetType: 'any'}], formatter: '.formatter.canPostHere'}">
                    <core:InvisibleText id="composerLabel" text="{i18n>composerPlaceholder}" />
                    <TextArea id="composerInput" class="rsComposerInput" width="100%" rows="1" growing="true"
                        growingMaxLines="6" valueLiveUpdate="true" value="{ui>/draft}" ariaLabelledBy="composerLabel"
                        placeholder="{i18n>composerPlaceholder}" liveChange=".composer.onLiveChange" />
                    <Button id="sendButton" class="rsSendButton" icon="sap-icon://paper-plane" type="Emphasized"
                        tooltip="{i18n>sendTooltip}" press=".composer.onSend"
                        enabled="{parts: [{path: 'ui>/draft'}, {path: 'ui>/sending'}], formatter: '.formatter.canSend'}" />
                </HBox>
                <HBox id="readOnlyNote" class="rsReadOnlyNote" renderType="Bare" alignItems="Center" justifyContent="Center"
                    visible="{parts: [{path: 'OnlyAdminsCanPost', targetType: 'any'}, {path: 'MyRole', targetType: 'any'}], formatter: '.formatter.cannotPostHere'}">
                    <core:Icon src="sap-icon://locked" decorative="true" class="rsReadOnlyIcon" />
                    <Text text="{i18n>onlyAdminsPost}" maxLines="2" />
                </HBox>
            </VBox>
        </VBox>

        <core:Fragment fragmentName="apps.dflc.resenha.view.fragments.DetailsPanel" type="XML" />

        <dependents>
            <Menu id="userMenu">
                <MenuItem id="menuProfile" text="{i18n>menuProfile}" icon="sap-icon://employee" press=".profile.onOpen" />
                <MenuItem id="menuInstall" text="{i18n>menuInstall}" icon="sap-icon://download" visible="{pwa>/canInstall}"
                    press=".install.onInstall" />
                <MenuItem id="menuNotifications" text="{i18n>menuNotifications}" icon="sap-icon://bell"
                    visible="{notifications>/configured}" press=".notifications.onOpen" />
                <MenuItem id="menuTheme" text="{i18n>menuTheme}" icon="sap-icon://palette" startsSection="true">
                    <items>
                        <MenuItem text="{i18n>themeLight}" icon="sap-icon://light-mode" press=".conversations.onTheme">
                            <customData><core:CustomData key="mode" value="light" /></customData>
                        </MenuItem>
                        <MenuItem text="{i18n>themeDark}" icon="sap-icon://dark-mode" press=".conversations.onTheme">
                            <customData><core:CustomData key="mode" value="dark" /></customData>
                        </MenuItem>
                        <MenuItem text="{i18n>themeAuto}" icon="sap-icon://settings" press=".conversations.onTheme">
                            <customData><core:CustomData key="mode" value="auto" /></customData>
                        </MenuItem>
                    </items>
                </MenuItem>
                <MenuItem id="menuLogout" text="{i18n>menuLogout}" icon="sap-icon://log" startsSection="true" press=".conversations.onLogout" />
            </Menu>

            <Menu id="newChatMenu">
                <MenuItem id="menuNewDirect" text="{i18n>newDirect}" icon="sap-icon://person-placeholder" press=".newChat.onNewDirect" />
                <MenuItem id="menuNewGroup" text="{i18n>newGroup}" icon="sap-icon://group" press=".newChat.onNewGroup" />
                <MenuItem id="menuNewChannel" text="{i18n>newChannel}" icon="sap-icon://marketing-campaign" press=".newChat.onNewChannel" />
                <MenuItem id="menuExplore" text="{i18n>exploreChannels}" icon="sap-icon://search" startsSection="true" press=".newChat.onExplore" />
            </Menu>

            <Menu id="rowMenu">
                <MenuItem id="rowMenuPin" text="{path: 'IsPinned', targetType: 'any', formatter: '.formatter.pinLabel'}" icon="sap-icon://pushpin-on"
                    press=".actions.onTogglePin" />
                <MenuItem id="rowMenuMute" text="{i18n>muteConversation}" icon="sap-icon://sound-off" startsSection="true"
                    visible="{path: 'MutedUntil', targetType: 'any', formatter: '.formatter.notMuted'}">
                    <items>
                        <MenuItem text="{i18n>mute8h}" press=".actions.onMute">
                            <customData><core:CustomData key="duration" value="8h" /></customData>
                        </MenuItem>
                        <MenuItem text="{i18n>mute1w}" press=".actions.onMute">
                            <customData><core:CustomData key="duration" value="1w" /></customData>
                        </MenuItem>
                        <MenuItem text="{i18n>muteForever}" press=".actions.onMute">
                            <customData><core:CustomData key="duration" value="forever" /></customData>
                        </MenuItem>
                    </items>
                </MenuItem>
                <MenuItem id="rowMenuUnmute" text="{i18n>unmuteConversation}" icon="sap-icon://sound"
                    visible="{path: 'MutedUntil', targetType: 'any', formatter: '.formatter.isMuted'}" press=".actions.onUnmute" />
                <MenuItem id="rowMenuArchive" text="{path: 'IsArchived', targetType: 'any', formatter: '.formatter.archiveLabel'}" icon="sap-icon://inbox"
                    startsSection="true" press=".actions.onToggleArchive" />
            </Menu>

            <Menu id="muteMenu">
                <MenuItem id="muteMenu8h" text="{i18n>mute8h}" icon="sap-icon://sound-off" press=".actions.onMute">
                    <customData><core:CustomData key="duration" value="8h" /></customData>
                </MenuItem>
                <MenuItem id="muteMenu1w" text="{i18n>mute1w}" icon="sap-icon://sound-off" press=".actions.onMute">
                    <customData><core:CustomData key="duration" value="1w" /></customData>
                </MenuItem>
                <MenuItem id="muteMenuForever" text="{i18n>muteForever}" icon="sap-icon://sound-off" press=".actions.onMute">
                    <customData><core:CustomData key="duration" value="forever" /></customData>
                </MenuItem>
                <MenuItem id="muteMenuUnmute" text="{i18n>unmuteConversation}" icon="sap-icon://sound" startsSection="true"
                    visible="{path: 'MutedUntil', targetType: 'any', formatter: '.formatter.isMuted'}" press=".actions.onUnmute" />
            </Menu>

            <Menu id="memberMenu">
                <MenuItem id="memberPromote" text="{path: 'Role', targetType: 'any', formatter: '.formatter.promoteLabel'}" icon="sap-icon://employee" press=".members.onToggleAdmin" />
                <MenuItem id="memberRemove" text="{i18n>removeMember}" icon="sap-icon://delete" press=".members.onRemove" />
            </Menu>
        </dependents>
    </HBox>
</mvc:View>
